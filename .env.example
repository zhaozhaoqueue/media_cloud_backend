# When API runs in Docker Compose and PostgreSQL runs on host machine,
# use host.docker.internal (not localhost).
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/media_cloud
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
LOG_LEVEL=INFO
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5
FORWARDED_ALLOW_IPS=*
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
STORAGE_BASE_URL=https://api.example.com
STORAGE_LOCAL_ROOT=./storage
READ_URL_TTL_SECONDS=600
READ_URL_SIGNING_SECRET=dev-read-url-secret
UPLOAD_TOKEN_TTL_SECONDS=900
THUMB_MAX_SIZE=512
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
