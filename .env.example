APP_NAME=Media Cloud API
APP_VERSION=0.1.0

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/media_cloud

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_BASE_URL=http://localhost:8000
READ_URL_TTL_SECONDS=600
READ_URL_SIGNING_SECRET=dev-read-url-secret
UPLOAD_TOKEN_TTL_SECONDS=900
THUMB_MAX_SIZE=512

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
