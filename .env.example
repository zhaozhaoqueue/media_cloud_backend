DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/media_cloud
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
STORAGE_BASE_URL=http://localhost:8000
STORAGE_LOCAL_ROOT=./storage
READ_URL_TTL_SECONDS=600
READ_URL_SIGNING_SECRET=dev-read-url-secret
UPLOAD_TOKEN_TTL_SECONDS=900
THUMB_MAX_SIZE=512
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
