APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
LOG_LEVEL=INFO
GUNICORN_TIMEOUT=60
GUNICORN_KEEPALIVE=5

# If API runs in Docker and PostgreSQL runs on host:
# keep host as host.docker.internal (requires extra_hosts in compose on Linux).
DATABASE_URL=postgresql+psycopg://media_cloud:media_cloud@host.docker.internal:5432/media_cloud

# Trust proxy headers only from known upstreams in production.
# Example: 127.0.0.1 or your reverse-proxy/container subnet.
FORWARDED_ALLOW_IPS=127.0.0.1

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
PROVIDER_HTTP_TIMEOUT_SECONDS=5
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

STORAGE_BASE_URL=https://media.weloverhea.cloud
STORAGE_LOCAL_ROOT=./storage
READ_URL_TTL_SECONDS=600
READ_URL_SIGNING_SECRET=
UPLOAD_TOKEN_TTL_SECONDS=900
THUMB_MAX_SIZE=512

CORS_ORIGINS=["https://media.weloverhea.cloud"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
